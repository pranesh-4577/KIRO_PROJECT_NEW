# AWS Region
AWS_REGION=us-east-1

# Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# DynamoDB Tables
DYNAMODB_COMPLAINTS_TABLE=smart-campus-complaints
DYNAMODB_USERS_TABLE=smart-campus-users
DYNAMODB_COUNTER_TABLE=smart-campus-counters

# S3
S3_BUCKET_NAME=smart-campus-complaints-images

# SES
SES_SENDER_EMAIL=noreply@yourdomain.com
APP_URL=https://yourdomain.com

# Feature flags
AI_CLASSIFIER_ENABLED=false

# Local dev only
PORT=4000
